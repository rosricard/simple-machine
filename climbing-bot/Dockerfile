# climbing-bot deployment image.
# TODO: pin base image, install system deps for CAN / Modbus as needed.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    POETRY_VERSION=1.8.3 \
    POETRY_VIRTUALENVS_CREATE=false \
    PYTHONPATH=/app/src

WORKDIR /app

RUN pip install --no-cache-dir "poetry==${POETRY_VERSION}"

# Install deps first for layer caching. (poetry.lock is regenerated by
# `poetry lock`; --no-root since src/ isn't installed as a package here.)
COPY pyproject.toml poetry.lock ./
RUN poetry install --no-root --only main

COPY . .

CMD ["python", "-m", "main"]
